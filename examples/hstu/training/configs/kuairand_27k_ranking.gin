# ------------ Training Command ------------
# CUDA_VISIBLE_DEVICES=0 PYTHONPATH=${PYTHONPATH}:$(realpath ../) torchrun --nproc_per_node 1 --master_addr localhost --master_port 6000 ./training/pretrain_gr_ranking.py --gin-config-file ./training/configs/kuairand_27k_ranking.gin
# ------------ Evaluation Command ------------
# CUDA_VISIBLE_DEVICES=0 PYTHONPATH=${PYTHONPATH}:$(realpath ../) torchrun --nproc_per_node 1 --master_addr localhost --master_port 6000 ./training/eval_checkpoint.py --gin-config-file ./training/configs/kuairand_27k_ranking.gin --ckpt-load-dir ckpt_kr_27k_ranking/iter550/
# ------------ Training Config ------------
TrainerArgs.train_batch_size = 32
TrainerArgs.eval_batch_size = 32
TrainerArgs.log_interval = 50
TrainerArgs.eval_interval = 50

DatasetArgs.dataset_name = 'kuairand-27k'
DatasetArgs.max_sequence_length = 8000
DatasetArgs.max_num_candidates = 256
DatasetArgs.shuffle = True

NetworkArgs.num_layers = 1
NetworkArgs.num_attention_heads = 4
NetworkArgs.hidden_size = 128
NetworkArgs.kv_channels = 128

RankingArgs.prediction_head_arch = [
    512, 8
]
RankingArgs.prediction_head_bias = True
RankingArgs.num_tasks = 8

OptimizerArgs.optimizer_str = 'adam'
OptimizerArgs.learning_rate = 1e-3