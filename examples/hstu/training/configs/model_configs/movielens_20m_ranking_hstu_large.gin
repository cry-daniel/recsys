# ------------ Training Command ------------
# CUDA_VISIBLE_DEVICES=0 PYTHONPATH=${PYTHONPATH}:$(realpath ../) torchrun --nproc_per_node 1 --master_addr localhost --master_port 6105 ./training/pretrain_gr_ranking.py --gin-config-file ./reports/model_configs/movielens_20m_ranking_hstu_large.gin
# ------------ Evaluation Command ------------
# CUDA_VISIBLE_DEVICES=0 PYTHONPATH=${PYTHONPATH}:$(realpath ../) torchrun --nproc_per_node 1 --master_addr localhost --master_port 6205 ./training/eval_checkpoint.py --gin-config-file ./reports/model_configs/movielens_20m_ranking_hstu_large.gin --ckpt-load-dir ckpt_ml_20m_ranking_hstu_large/iter1000/
TrainerArgs.train_batch_size = 32
TrainerArgs.eval_batch_size = 32
TrainerArgs.eval_interval = 1000
TrainerArgs.log_interval = 100
TrainerArgs.seed = 1234
TrainerArgs.max_train_iters = 1000
TrainerArgs.profile = True
TrainerArgs.ckpt_save_interval = 1000
TrainerArgs.ckpt_save_dir = "ckpt_ml_20m_ranking_hstu_large"

DatasetArgs.dataset_name = 'ml-20m'
DatasetArgs.max_sequence_length = 200
DatasetArgs.shuffle = True
DatasetArgs.max_num_candidates = 128

NetworkArgs.dtype_str = "bfloat16"
NetworkArgs.num_layers = 12
NetworkArgs.num_attention_heads = 4
NetworkArgs.hidden_size = 1024
NetworkArgs.kv_channels = 256
NetworkArgs.target_group_size = 1

# OOM fallback for the large MovieLens model; the model scale remains
# 12 layers / 1024 hidden.
DynamicEmbeddingArgs.item_vocab_gpu_capacity_ratio = 0.2
TensorModelParallelArgs.tensor_model_parallel_size = 1

# ratings 0-5
RankingArgs.prediction_head_arch = [1024, 10]
RankingArgs.prediction_head_bias = True
RankingArgs.num_tasks = 1
RankingArgs.eval_metrics = ("AUC",)

OptimizerArgs.optimizer_str = 'adam'
OptimizerArgs.learning_rate = 1e-3
OptimizerArgs.adam_beta1 = 0.9
OptimizerArgs.adam_beta2 = 0.98
