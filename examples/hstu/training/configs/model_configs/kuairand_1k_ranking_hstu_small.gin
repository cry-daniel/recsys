# ------------ Training Command ------------
# CUDA_VISIBLE_DEVICES=0 PYTHONPATH=${PYTHONPATH}:$(realpath ../) torchrun --nproc_per_node 1 --master_addr localhost --master_port 6100 ./training/pretrain_gr_ranking.py --gin-config-file ./reports/model_configs/kuairand_1k_ranking_hstu_small.gin
# ------------ Evaluation Command ------------
# CUDA_VISIBLE_DEVICES=0 PYTHONPATH=${PYTHONPATH}:$(realpath ../) torchrun --nproc_per_node 1 --master_addr localhost --master_port 6200 ./training/eval_checkpoint.py --gin-config-file ./reports/model_configs/kuairand_1k_ranking_hstu_small.gin --ckpt-load-dir ckpt_kr_1k_ranking_hstu_small/iter1000/
# ------------ Training Config ------------
TrainerArgs.train_batch_size = 8
TrainerArgs.eval_batch_size = 8
TrainerArgs.log_interval = 10
TrainerArgs.eval_interval = 50
TrainerArgs.max_train_iters = 1000
TrainerArgs.ckpt_save_interval = 1000
TrainerArgs.ckpt_save_dir = "ckpt_kr_1k_ranking_hstu_small"

DatasetArgs.dataset_name = 'kuairand-1k'
DatasetArgs.max_sequence_length = 4096
DatasetArgs.max_num_candidates = 128
DatasetArgs.shuffle = False

NetworkArgs.num_layers = 4
NetworkArgs.num_attention_heads = 4
NetworkArgs.hidden_size = 256
NetworkArgs.kv_channels = 64

RankingArgs.prediction_head_arch = [
    256, 8
]
RankingArgs.prediction_head_bias = True
RankingArgs.num_tasks = 8

OptimizerArgs.optimizer_str = 'adam'
OptimizerArgs.learning_rate = 1e-3
