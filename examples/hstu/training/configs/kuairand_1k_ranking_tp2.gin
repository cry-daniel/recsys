# ------------ Training Command ------------
# CUDA_VISIBLE_DEVICES=0,1 PYTHONPATH=${PYTHONPATH}:$(realpath ../) torchrun --nproc_per_node 2 --master_addr localhost --master_port 6000 ./training/pretrain_gr_ranking.py --gin-config-file ./training/configs/kuairand_1k_ranking_tp2.gin
# ------------ Evaluation Command ------------
# CUDA_VISIBLE_DEVICES=0,1 PYTHONPATH=${PYTHONPATH}:$(realpath ../) torchrun --nproc_per_node 2 --master_addr localhost --master_port 6000 ./training/eval_checkpoint.py --gin-config-file ./training/configs/kuairand_1k_ranking_tp2.gin --ckpt-load-dir ckpt_kr_1k_ranking_tp2/iter550/
# ------------ Training Config ------------
TrainerArgs.train_batch_size = 4
TrainerArgs.eval_batch_size = 8
TrainerArgs.log_interval = 10
TrainerArgs.eval_interval = 10
TrainerArgs.log_interval = 10
TrainerArgs.max_train_iters = 550

DatasetArgs.dataset_name = 'kuairand-1k'
DatasetArgs.max_sequence_length = 4096
DatasetArgs.max_num_candidates = 100
DatasetArgs.shuffle = False

NetworkArgs.num_layers = 3
NetworkArgs.num_attention_heads = 4
NetworkArgs.hidden_size = 512
NetworkArgs.kv_channels = 128

RankingArgs.prediction_head_arch = [
    512, 8
]
RankingArgs.prediction_head_bias = True
RankingArgs.num_tasks = 8

OptimizerArgs.optimizer_str = 'adam'
OptimizerArgs.learning_rate = 1e-3

TensorModelParallelArgs.tensor_model_parallel_size = 2